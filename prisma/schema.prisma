// Östafrikansk webbutik – datamodell
// Kör: npx prisma generate && npx prisma db push (eller migrate)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Produktkategori (t.ex. Dirac, Baatis, Unsi) – varje produkt tillhör exakt en kategori.
model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  priceCents  Int       // Pris i öre för att undvika flyttalsfel
  imageUrl    String?
  categoryId  String // FK till produktkategori (Category).
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  inStock     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  variants    ProductVariant[]
  orderItems  OrderItem[]

  @@index([categoryId])
  @@index([slug])
}

// Säljbar variant av en produkt (kläd-dimensioner – inte samma som Category).
// Exempel: samma dirac i olika färg/storlek/stil. Tomma fält = dimension används inte för raden.
model ProductVariant {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  style        String?
  color        String?
  size         String?
  material     String?
  sku          String?  @unique
  priceCents   Int? // öre; null = ärv Product.priceCents
  imageUrl     String?
  inStock      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orderItems   OrderItem[]

  @@index([productId])
}

model Order {
  id             String      @id @default(cuid())
  customerName   String
  customerEmail  String
  customerAddress String
  customerPhone  String?
  totalCents     Int
  status         OrderStatus @default(PENDING)
  items          OrderItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([createdAt])
  @@index([status])
}

model OrderItem {
  id               String          @id @default(cuid())
  orderId          String
  productId        String
  productVariantId String?
  quantity         Int
  unitPriceCents   Int
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id])
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([productVariantId])
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}
